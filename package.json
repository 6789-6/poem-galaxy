{
  "name": "poem-galaxy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:import": "tsx scripts/import-poetry-data.ts",
    "data:verify": "tsx scripts/verify-data-artifacts.ts",
    "budget": "node scripts/check-bundle-budget.mjs",
    "check": "npm run test && npm run typecheck && npm run data:verify && npm run build && npm run budget"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.167.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.167.2",
    "@vitejs/plugin-react": "4.3.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^4.1.10"
  }
}
