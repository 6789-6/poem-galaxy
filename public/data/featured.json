  "poems": [
    {
      "id": "1e3bzxz",
      "title": "河伯",
      "authorId": "fi7gla",
      "dynasty": "pre-qin",
      "lines": [
        "与女游兮九河，冲风起兮水扬波",
        "乘水车兮荷盖，驾两龙兮骖螭",
        "登昆仑兮四望，心飞扬兮浩荡",
        "日将暮兮怅忘归，惟极浦兮寤怀",
        "鱼鳞屋兮龙堂，紫贝阙兮珠宫",
        "灵何惟兮水中",
        "乘白鼋兮逐文鱼，与女游兮河之渚",
        "流澌纷兮将来下",
        "子交手兮东行，送美人兮南浦",
        "波滔滔兮来迎，鱼鳞鳞兮媵予。"
      ],
      "themes": [
        "山河",
        "离别"
      ],
      "textAvailability": "full"
    },
    {
      "id": "4sj32k",
      "title": "东皇太一",
      "authorId": "fi7gla",
      "dynasty": "pre-qin",
      "lines": [
        "吉日兮辰良，穆将愉兮上皇",
        "抚长剑兮玉珥，璆锵鸣兮琳琅",
        "瑶席兮玉瑱，盍将把兮琼芳",
        "蕙肴蒸兮兰藉，奠桂酒兮椒浆",
        "扬枹兮拊鼓，疏缓节兮安歌",
        "陈竽瑟兮浩倡",
        "灵偃蹇兮姣服，芳菲菲兮满堂",
        "五音纷兮繁会，君欣欣兮乐康。"
      ],
      "themes": [
        "酒"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1qh2bvo",
      "title": "大司命",
      "authorId": "fi7gla",
      "dynasty": "pre-qin",
      "lines": [
        "广开兮天门，纷吾乘兮玄云",
        "令飘风兮先驱，使涷雨兮洒尘",
        "君回翔兮以下，逾空桑兮从女",
        "纷总总兮九州，何寿夭兮在予",
        "高飞兮安翔，乘清气兮御阴阳",
        "吾与君兮齐速，导帝之兮九坑",
        "灵衣兮被被，玉佩兮陆离",
        "一阴兮一阳，众莫知兮余所为",
        "折疏麻兮瑶华，将以遗兮离居",
        "老冉冉兮既极，不寖近兮愈疏",
        "乘龙兮辚辚，高驰兮冲天",
        "结桂枝兮延伫，羌愈思兮愁人",
        "愁人兮奈何，愿若今兮无亏",
        "固人命兮有当，孰离合兮何为？"
      ],
      "themes": [],
      "textAvailability": "full"
    },
    {
      "id": "11y0icy",
      "title": "善哉行 其三",
      "authorId": "1d6kq5i",
      "dynasty": "han-wei",
      "lines": [
        "朝日乐相乐，酣饮不知醉。",
        "悲弦激新声，长笛吹清气。",
        "弦歌感人肠，四坐皆欢悦。",
        "寥寥高堂上，凉风入我室。",
        "持满如不盈，有德者能卒。",
        "君子多苦心，所愁不但一。",
        "慊慊下白屋，吐握不可失。",
        "众宾饱满归，主人苦不悉。",
        "比翼翔云汉，罗者安所羁？",
        "冲静得自然，荣华何足为！"
      ],
      "themes": [
        "酒"
      ],
      "textAvailability": "full"
    },
    {
      "id": "ww03e0",
      "title": "气出唱 其一",
      "authorId": "1d6kq5i",
      "dynasty": "han-wei",
      "lines": [
        "华阴山，自以为大。",
        "高百丈，浮云为之盖。",
        "仙人欲来，出随风，列之雨。",
        "吹我洞箫，鼓瑟琴，何訚訚！",
        "酒与歌戏，今日相乐诚为乐。",
        "玉女起，起舞移数时。",
        "鼓吹一何嘈嘈。",
        "从西北来时，仙道多驾烟，",
        "乘云驾龙，郁何务务。",
        "遨游八极，乃到昆仑之山，",
        "西王母侧，神仙金止玉亭。",
        "来者为谁？赤松王乔，乃德旋之门。",
        "乐共饮食到黄昏。",
        "多驾合坐，万岁长，宜子孙。"
      ],
      "themes": [
        "酒",
        "山河"
      ],
      "textAvailability": "full"
    },
    {
      "id": "5go5iy",
      "title": "气出唱 其三",
      "authorId": "1d6kq5i",
      "dynasty": "han-wei",
      "lines": [
        "游君山，甚为真。",
        "崔嵬砟硌，尔自为神。",
        "乃到王母台，金阶玉为堂，芝草生殿旁。",
        "东西厢，客满堂。",
        "主人当行觞，坐者长寿遽何央。",
        "长乐甫始宜孙子。",
        "常愿主人增年，与天相守。"
      ],
      "themes": [
        "山河"
      ],
      "textAvailability": "full"
    },
    {
      "id": "vi1i2b",
      "title": "滕王閣",
      "authorId": "1x1elej",
      "dynasty": "tang",
      "lines": [
        "滕王高閣臨江渚，珮玉鳴鸞罷歌舞。",
        "畫棟朝飛南浦雲，珠簾暮捲西山雨。",
        "閑雲潭影日悠悠，物換星移幾度秋。",
        "閣中帝子今何在？檻外長江空自流。"
      ],
      "themes": [
        "山河",
        "秋"
      ],
      "textAvailability": "full"
    },
    {
      "id": "v8434s",
      "title": "倬彼我系 三",
      "authorId": "1x1elej",
      "dynasty": "tang",
      "lines": [
        "伊我有器，思逢其主。",
        "自東施西，擇木開宇。",
        "田彼河曲，家乎汾浦。",
        "天未厭亂，吾將誰輔。"
      ],
      "themes": [
        "山河",
        "田园"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1suj0jh",
      "title": "出境遊山二首 一",
      "authorId": "1x1elej",
      "dynasty": "tang",
      "lines": [
        "源水終無路，山阿若有人。",
        "驅羊先動石，走兔欲投巾。",
        "洞晚秋泉冷，巖朝古樹新。",
        "峰斜連鳥翅，磴疊上魚鱗。",
        "化鶴千齡早，元龜六代春。",
        "浮雲今可駕，滄海自成塵。"
      ],
      "themes": [
        "山河",
        "秋",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1r77bzx",
      "title": "遊景空寺蘭若",
      "authorId": "1c5qh5l",
      "dynasty": "tang",
      "lines": [
        "龍象經行處，山腰度石關。",
        "屢迷青嶂合，時愛綠蘿閑。",
        "宴息花林下，高談竹嶼間。",
        "寥寥隔塵事，疑是入雞山。"
      ],
      "themes": [
        "山河",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1o0v7hq",
      "title": "陪姚使君題惠上人房",
      "authorId": "1c5qh5l",
      "dynasty": "tang",
      "lines": [
        "帶雪梅初煖，含煙柳尚青。",
        "來窺童子偈，得聽法王經。",
        "會理知無我，觀空厭有形。",
        "迷心應覺悟，客思未遑寧。"
      ],
      "themes": [],
      "textAvailability": "full"
    },
    {
      "id": "siujqy",
      "title": "宿建德江",
      "authorId": "1c5qh5l",
      "dynasty": "tang",
      "lines": [
        "移舟泊煙渚，日暮客愁新。",
        "野曠天低樹，江清月近人。"
      ],
      "themes": [
        "月",
        "山河"
      ],
      "textAvailability": "full"
    },
    {
      "id": "e1bisa",
      "title": "河南嚴尹弟見宿弊廬訪別人賦十韻",
      "authorId": "3vs3xm",
      "dynasty": "tang",
      "lines": [
        "上客能論道，吾生學養蒙。",
        "貧交世情外，才子古人中。",
        "冠上方簪豸，車邊已畫熊。",
        "拂衣迎五馬，垂手憑雙童。",
        "花醥和松屑，茶香透竹叢。",
        "薄霜澄夜月，殘雪帶春風。",
        "古壁蒼苔黑，寒山遠燒紅。",
        "眼看東候別，心事北川同。",
        "爲學輕先輩，何能訪老翁。",
        "欲知今日後，不樂爲車公。"
      ],
      "themes": [
        "月",
        "山河",
        "秋",
        "春"
      ],
      "textAvailability": "full"
    },
