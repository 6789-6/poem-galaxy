      "authorId": "a2lqh9",
      "dynasty": "song",
      "lines": [
        "见来便觉情於我。",
        "厮守著、新来好过。",
        "人道他家有婆婆。",
        "与一口、管教�拍ァ�",
        "副靖传语木大。",
        "鼓儿里、且打一和。",
        "更有些儿得处囉。",
        "烧沙糖、香药添和。"
      ],
      "themes": [],
      "textAvailability": "full"
    },
    {
      "id": "amfs6y",
      "title": "春帖子 皇帝閣",
      "authorId": "137cglg",
      "dynasty": "song",
      "lines": [
        "莫進黄金簟，新除玉局牀。",
        "春風送庭燎，不復用沈香。"
      ],
      "themes": [
        "离别",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "17wetw7",
      "title": "玉楼春",
      "authorId": "l9t29m",
      "dynasty": "song",
      "lines": [
        "江头一带斜阳树。",
        "总是六朝人住处。",
        "悠悠兴废不关心，惟有沙洲双白鹭。",
        "仙人矶下多风雨。",
        "好卸征帆留不住。",
        "直须抖擞尽尘埃，却趁新凉秋水去。"
      ],
      "themes": [
        "山河",
        "秋"
      ],
      "textAvailability": "full"
    },
    {
      "id": "sqvc8s",
      "title": "南乡子",
      "authorId": "l9t29m",
      "dynasty": "song",
      "lines": [
        "日日老莱衣。",
        "更解风流蜡凤嬉。",
        "膝上放教文度去，须知。",
        "要使人看玉树枝。",
        "剩记乃翁诗。",
        "绿水红莲觅旧题。",
        "归骑春衫花满路，相期。",
        "来岁流觞曲水时。"
      ],
      "themes": [
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "kg4lkn",
      "title": "浪淘沙",
      "authorId": "l9t29m",
      "dynasty": "song",
      "lines": [
        "身世酒杯中。",
        "万事皆空。",
        "古来三五个英雄。",
        "雨打风吹何处是，汉殿秦宫。",
        "梦入少年丛。",
        "歌舞匆匆。",
        "老僧夜半误鸣钟。",
        "惊起西窗眠不得，卷地西风。"
      ],
      "themes": [
        "酒"
      ],
      "textAvailability": "full"
    },
    {
      "id": "ompg4f",
      "title": "枕上作",
      "authorId": "sjf704",
      "dynasty": "song",
      "lines": [
        "一室幽幽夢不成，高城傳漏過三更。",
        "孤燈無焰穴鼠出，枯葉有聲鄰犬行。",
        "壯日自期如孟博，殘年但欲慕初平。",
        "不然短楫棄家去，萬頃松江看月明。"
      ],
      "themes": [
        "月",
        "山河"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1tcg4i",
      "title": "幽居即事二首 其一",
      "authorId": "sjf704",
      "dynasty": "song",
      "lines": [
        "山崦可伐薪，稻隴可負耒。",
        "但令二事集，一飽已有在。",
        "霜林兩株橘，春圃數畦菜。",
        "仁哉造物心，乞我曾不愛。",
        "炊烹付樵青，鉏灌頼阿對。",
        "乃翁亦自爲，高枕聽晨碓。"
      ],
      "themes": [
        "山河",
        "秋",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1tcfqbr",
      "title": "夜食炒栗有感",
      "authorId": "sjf704",
      "dynasty": "song",
      "lines": [
        "齒根浮動嘆吾衰，山栗炮燔療夜饑。",
        "喚起少年京輦夢，和寜門外早朝來。"
      ],
      "themes": [
        "山河"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1l1oc8d",
      "title": "采桑子",
      "authorId": "17rpfye",
      "dynasty": "song",
      "lines": [
        "群芳过後西湖好，狼籍残红。",
        "飞絮蒙蒙。",
        "垂柳阑干尽日风。",
        "笙歌散尽游人去，始觉春空。",
        "垂下帘栊。",
        "双燕归来细雨中。"
      ],
      "themes": [
        "山河",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "nygbuc",
      "title": "浪淘沙",
      "authorId": "17rpfye",
      "dynasty": "song",
      "lines": [
        "把酒祝东风。",
        "且共从容。",
        "垂杨紫陌洛城东。",
        "总是当时携手处，游遍芳丛。",
        "聚散苦匆匆。",
        "此恨无穷。",
        "今年花胜去年红。",
        "可惜明年花更好，知与谁同。"
      ],
      "themes": [
        "酒",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1xwmvzx",
      "title": "洞仙歌令・洞仙歌",
      "authorId": "17rpfye",
      "dynasty": "song",
      "lines": [
        "楼前乱草，是离人方寸。",
        "倚遍阑干意无尽。",
        "罗巾掩，宿粉残眉、香未减，人与天涯共远。",
        "香闺知人否，长是厌厌，拟写相思寄归信。",
        "未写了，泪成行、早满香笺。",
        "相思字、一时滴损。",
        "便直饶、伊家总无情，也拼了一生，为伊成病。"
      ],
      "themes": [],
      "textAvailability": "full"
    },
    {
      "id": "n15leo",
      "title": "疊翠亭",
      "authorId": "1vq1ptz",
      "dynasty": "song",
      "lines": [
        "煙籠遠浦迷芳草，日照澄湖浸碧峰。",
        "幸有清樽堪酩酊，忍陪良友不從容。"
      ],
      "themes": [
        "酒",
        "山河"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1a6tf3j",
      "title": "夢中作",
      "authorId": "1vq1ptz",
      "dynasty": "song",
      "lines": [
        "青門道北雲爲屋，大壚貯酒千萬斛。",
        "獨龍注雨如車軸，不畏不售畏不續。"
      ],
      "themes": [
        "酒"
      ],
      "textAvailability": "full"
    },
    {
      "id": "11nqpkr",
      "title": "雙廟",
      "authorId": "1vq1ptz",
      "dynasty": "song",
      "lines": [
        "兩公天下駿，無地與騰驤。",
        "就死得處所，至今猶耿光。",
        "中原擅兵革，昔日幾侯王。",
        "此獨身如在，誰令國不亡。",
        "北風吹樹急，西日照窗凉。",
        "志士千年淚，泠然落奠觴。"
      ],
      "themes": [],
      "textAvailability": "full"
    },
    {
      "id": "1ok6iel",
      "title": "江州司马青衫泪・普天乐",
      "authorId": "iejiuq",
      "dynasty": "yuan-ming-qing",
      "lines": [
        "到浔阳，无牵挂。",
        "吊英魂何处，渡口残霞。",
        "思往事，空嗟呀。",
        "半夜灯前长吁罢，泪和愁付与琵琶。",
        "寒波漾漾，芳心脉脉，明月芦花。",
        "(驾云)原来你弹琵琶来？那白居易可在那里听见，得与你相会？你再说咱。",
        "(正旦唱)。"
      ],
      "themes": [
        "月",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "9ry2l5",
      "title": "西华山陈抟高卧・步步娇",
      "authorId": "iejiuq",
      "dynasty": "yuan-ming-qing",
      "lines": [
        "遮莫胡厮缠到晨钟撞，休想我一点狂心荡。",
        "(色旦云)你来，我与你有句话说。",
        "(正末唱)唤陈抟有甚勾当？命不快遭烽着这火醉婆娘，干误了我晚夕参圣一炉香，半夜里观乾象。"
      ],
      "themes": [
        "酒"
      ],
      "textAvailability": "full"
    },
    {
      "id": "1h6htt1",
      "title": "马丹阳三度任风子・仙吕/点绛唇",
      "authorId": "iejiuq",
      "dynasty": "yuan-ming-qing",
      "lines": [
        "朋友相怜，弟兄错见，任屠面。",
        "今日何缘，因贱降来宅院。"
      ],
      "themes": [],
      "textAvailability": "full"
    },
    {
      "id": "15yag35",
      "title": "浣溪沙·桦屋鱼衣柳作城",
      "authorId": "81xquf",
      "dynasty": "yuan-ming-qing",
      "lines": [
        "桦屋鱼衣柳作城，蛟龙鳞动浪花腥，飞扬应逐海东青",
        "犹记当年军垒迹，不知何处梵钟声，莫将兴废话分明"
      ],
      "themes": [
        "山河",
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "x66jni",
      "title": "朝中措·蜀弦秦柱不关情",
      "authorId": "81xquf",
      "dynasty": "yuan-ming-qing",
      "lines": [
        "蜀弦秦柱不关情，尽日掩云屏",
        "己惜轻翎退粉，更嫌弱絮为萍",
        "东风多事，余寒吹散，烘暖微酲",
        "看尽一帘红雨，为谁亲系花铃"
      ],
      "themes": [
        "春"
      ],
      "textAvailability": "full"
    },
    {
      "id": "rzx8ub",
      "title": "清平乐·画屏无睡",
      "authorId": "81xquf",
      "dynasty": "yuan-ming-qing",
      "lines": [
        "画屏无睡，雨点惊风碎",
        "贪话零星兰焰坠，闲了半床红被",
        "生来柳絮飘零，便教咒也无灵",
        "待问归期还未，已看双睫盈盈"
      ],
      "themes": [],
      "textAvailability": "full"
